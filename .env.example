ROOM_CONFIG=examples/voice-room/room.example.json
PA_BASE_URL=https://example.com/v1
PA_MODEL=your-model-id
PA_API_KEY=replace-with-your-api-key
ROOM_QQ_A_TOKEN=
ROOM_QQ_B_TOKEN=

# 看图（多模态）：默认开启主模型看图（从不落盘、不写入 SQLite）。
# 若主模型不支持视觉可设为 false，或单独配置专用视觉模型（覆盖主模型用于含图消息）：
# PA_MODEL_SUPPORTS_VISION=true
# PA_VISION_MODEL=
# PA_VISION_BASE_URL=
# PA_VISION_API_KEY=

# 可选语音：同时把房间配置的 deliveryMode 改为 both。
# FISH_API_KEY=
# FISH_MODEL=
# FISH_REFERENCE_ID_A=
# FISH_REFERENCE_ID_B=
